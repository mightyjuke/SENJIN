; SENJIN native client. Open with Godot 4.7.2 (standard, not .NET).
config_version=5

[application]
config/name="SENJIN"
config/version="0.1.0"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=6
window/energy_saving/keep_screen_on=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.19, 1)

[physics]
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=5

[input_devices]
pointing/emulate_touch_from_mouse=false
; Native menu Controls need the emulated mouse stream. Gameplay filters device -1.
pointing/emulate_mouse_from_touch=true

[audio]
general/default_bus_layout="res://default_bus_layout.tres"

[editor]
version_control/autoload_on_startup=false
